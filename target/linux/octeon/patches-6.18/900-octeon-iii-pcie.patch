+static int cvmx_pcie_cn70xx_measure_refclock(int qlm)
+{
+	union cvmx_mio_ptp_clock_cfg ptp_clock;
+	u64 count, start_cycle, stop_cycle;
+	int incr_count = 1;
+
+	if (qlm == 0 && (cvmx_read_csr(CVMX_GSERX_DLMX_REF_CLKDIV2(qlm)) & 1))
+		incr_count = 2;
+
+	ptp_clock.u64 = cvmx_read_csr(CVMX_MIO_PTP_CLOCK_CFG);
+	ptp_clock.s.evcnt_en = 0;
+	cvmx_write_csr(CVMX_MIO_PTP_CLOCK_CFG, ptp_clock.u64);
+	ptp_clock.u64 = cvmx_read_csr(CVMX_MIO_PTP_CLOCK_CFG);
+	ptp_clock.s.evcnt_edge = 0;
+	ptp_clock.s.evcnt_in = 0x10 + qlm;
+	cvmx_write_csr(CVMX_MIO_PTP_CLOCK_CFG, ptp_clock.u64);
+
+	/* The event counter counts down from its programmed value. */
+	cvmx_read_csr(CVMX_MIO_PTP_EVT_CNT);
+	count = cvmx_read_csr(CVMX_MIO_PTP_EVT_CNT);
+	cvmx_write_csr(CVMX_MIO_PTP_EVT_CNT, -count);
+	cvmx_write_csr(CVMX_MIO_PTP_EVT_CNT, 1000000000);
+	ptp_clock.u64 = cvmx_read_csr(CVMX_MIO_PTP_CLOCK_CFG);
+	ptp_clock.s.evcnt_en = 1;
+	cvmx_write_csr(CVMX_MIO_PTP_CLOCK_CFG, ptp_clock.u64);
+	start_cycle = cvmx_get_cycle();
+	mdelay(50);
+	cvmx_read_csr(CVMX_MIO_PTP_EVT_CNT);
+	count = cvmx_read_csr(CVMX_MIO_PTP_EVT_CNT);
+	stop_cycle = cvmx_get_cycle();
+	ptp_clock.u64 = cvmx_read_csr(CVMX_MIO_PTP_CLOCK_CFG);
+	ptp_clock.s.evcnt_en = 0;
+	cvmx_write_csr(CVMX_MIO_PTP_CLOCK_CFG, ptp_clock.u64);
+
+	count = (1000000000 - count) * incr_count;
+	if (stop_cycle == start_cycle)
+		return 0;
+	return (u64)count * octeon_get_clock_rate() /
+		(stop_cycle - start_cycle);
+}
+
+static int cvmx_pcie_cn70xx_fix_mpll(int qlm)
+{
+	u64 refclock;
+	int old_multiplier;
+	int multiplier;
+
+	refclock = cvmx_pcie_cn70xx_measure_refclock(qlm);
+	if (refclock > 99000000 && refclock < 101000000)
+		old_multiplier = 35;
+	else if (refclock > 124000000 && refclock < 126000000)
+		old_multiplier = 56;
+	else if (refclock > 156000000 && refclock < 156500000)
+		old_multiplier = 45;
+	else
+		return -EINVAL;
+
+	/* Errata 20669: lower the multiplier one step at a time. */
+	multiplier = ((u64)2500000000 + refclock / 2) / refclock;
+	while (old_multiplier > multiplier) {
+		old_multiplier--;
+		cvmx_write_csr(CVMX_GSERX_DLMX_MPLL_MULTIPLIER(qlm),
+			old_multiplier);
+		mdelay(1);
+	}
+
+	return 0;
+}
